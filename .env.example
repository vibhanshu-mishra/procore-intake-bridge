# Safe local defaults. Never put credentials or tokens in this file.
PROCORE_INTAKE_ENVIRONMENT=local
PROCORE_INTAKE_REQUIRE_SAFE_PRODUCTION_SETTINGS=true
PROCORE_INTAKE_DATABASE_URL=sqlite:///./procore_intake_bridge.db
PROCORE_INTAKE_PUBLIC_BASE_URL=
PROCORE_INTAKE_ALLOWED_HOSTS=localhost,127.0.0.1
PROCORE_INTAKE_CORS_ORIGINS=
PROCORE_INTAKE_LOG_LEVEL=INFO
PROCORE_INTAKE_ENABLE_STARTUP_CHECKS=true
PROCORE_INTAKE_FAIL_STARTUP_ON_UNSAFE_PRODUCTION=true
PROCORE_INTAKE_MIGRATION_CHECK_ENABLED=true
PROCORE_INTAKE_AUTO_RUN_MIGRATIONS=false
PROCORE_INTAKE_FAIL_READINESS_ON_PENDING_MIGRATIONS=false
PROCORE_INTAKE_MIGRATION_SCRIPT_LOCATION=migrations
PROCORE_INTAKE_MIGRATION_ALLOW_DESTRUCTIVE=false
APP_PROCORE_MODE=fixture
APP_FIXTURE_DIR=app/fixtures

# Phase A2 live DMSA boundary. Keep false for normal local development and all tests.
PROCORE_INTAKE_LIVE_MODE_ENABLED=false
PROCORE_INTAKE_SECRET_PROVIDER=env
PROCORE_INTAKE_SECRET_REF_PREFIX=PROCORE_INTAKE_SECRET_
PROCORE_INTAKE_SECRET_REQUIRE_PREFIX=true
PROCORE_INTAKE_SECRET_MASK_MODE=last4
PROCORE_INTAKE_SECRET_HEALTH_CHECK_ENABLED=true
PROCORE_INTAKE_SECRET_FAIL_CLOSED=true
# B2 placeholders only. No external adapter or network call is implemented.
PROCORE_INTAKE_EXTERNAL_SECRET_PROVIDER_NAME=
PROCORE_INTAKE_EXTERNAL_SECRET_PROVIDER_REGION=
PROCORE_INTAKE_EXTERNAL_SECRET_PROVIDER_PROJECT=
PROCORE_INTAKE_EXTERNAL_SECRET_PROVIDER_VAULT_URL=
PROCORE_INTAKE_API_BASE=https://api.procore.com
PROCORE_INTAKE_LOGIN_URL=https://login.procore.com
PROCORE_INTAKE_REQUEST_TIMEOUT_SECONDS=30
PROCORE_INTAKE_PROCORE_ENVIRONMENT=production

# Local run-once polling defaults. No daemon or external queue is used.
PROCORE_INTAKE_DEFAULT_POLLING_INTERVAL_MINUTES=30
PROCORE_INTAKE_SYNC_LOCK_TIMEOUT_MINUTES=30
PROCORE_INTAKE_WORKER_ID=local-dev-worker
PROCORE_INTAKE_MAX_SYNC_LOOKBACK_DAYS=30

# Local webhook receiver and database event queue.
# Header names and HMAC format are configurable placeholders; verify current
# Procore signing documentation before production use.
PROCORE_INTAKE_WEBHOOKS_ENABLED=true
PROCORE_INTAKE_REQUIRE_WEBHOOK_SIGNATURE=false
PROCORE_INTAKE_WEBHOOK_SIGNATURE_HEADER=x-procore-signature
PROCORE_INTAKE_WEBHOOK_EVENT_ID_HEADER=x-procore-event-id
PROCORE_INTAKE_WEBHOOK_SECRET_PROVIDER=env
PROCORE_INTAKE_WEBHOOK_SECRET_NAME=
PROCORE_INTAKE_WEBHOOK_VERIFICATION_ENABLED=false
PROCORE_INTAKE_WEBHOOK_VERIFICATION_REQUIRE_CONFIRMATION=true
PROCORE_INTAKE_WEBHOOK_VERIFICATION_CONFIRMATION_PHRASE=I_UNDERSTAND_THIS_ONLY_VERIFIES_WEBHOOK_RECEIVER_BEHAVIOR
PROCORE_INTAKE_WEBHOOK_VERIFICATION_ALLOW_PRODUCTION=false
PROCORE_INTAKE_WEBHOOK_VERIFICATION_OUTPUT_ROOT=./webhook-verification-output
PROCORE_INTAKE_WEBHOOK_VERIFICATION_WRITE_REPORT=true
PROCORE_INTAKE_WEBHOOK_VERIFICATION_MAX_EVENTS=5
PROCORE_INTAKE_WEBHOOK_VERIFICATION_REQUIRE_DOCS_CHECK=true
PROCORE_INTAKE_WEBHOOK_VERIFICATION_DOCS_STATUS=unverified
PROCORE_INTAKE_WEBHOOK_VERIFICATION_EXPECTED_PAYLOAD_VERSION=
PROCORE_INTAKE_WEBHOOK_VERIFICATION_EXPECTED_SCOPE=company_or_project
PROCORE_INTAKE_EVENT_LOCK_TIMEOUT_MINUTES=30
PROCORE_INTAKE_EVENT_MAX_ATTEMPTS=5
PROCORE_INTAKE_EVENT_WORKER_ID=local-dev-event-worker

# Local attachment manifest and fixture-only byte storage.
PROCORE_INTAKE_ATTACHMENT_STORAGE_PROVIDER=local
# Legacy A5 alias; keep local unless migrating an older configuration.
PROCORE_INTAKE_ATTACHMENT_STORAGE_BACKEND=local
PROCORE_INTAKE_ATTACHMENT_STORAGE_ROOT=./storage/attachments
PROCORE_INTAKE_ATTACHMENT_STORAGE_REQUIRE_SAFE_KEYS=true
PROCORE_INTAKE_ATTACHMENT_STORAGE_HEALTH_CHECK_ENABLED=true
PROCORE_INTAKE_ATTACHMENT_STORAGE_FAIL_CLOSED=true
PROCORE_INTAKE_ATTACHMENT_STORAGE_MAX_OBJECT_BYTES=25000000
PROCORE_INTAKE_ATTACHMENT_STORAGE_ALLOWED_CONTENT_TYPES=
PROCORE_INTAKE_ATTACHMENT_STORAGE_QUARANTINE_UNKNOWN_TYPES=true
PROCORE_INTAKE_ATTACHMENT_STORAGE_WRITE_METADATA_ONLY=false
PROCORE_INTAKE_ATTACHMENT_STORAGE_EXTERNAL_PROVIDER_NAME=
PROCORE_INTAKE_ATTACHMENT_STORAGE_EXTERNAL_BUCKET_REF=
PROCORE_INTAKE_ATTACHMENT_STORAGE_EXTERNAL_REGION=
PROCORE_INTAKE_ATTACHMENT_STORAGE_EXTERNAL_ENDPOINT_REF=
PROCORE_INTAKE_ATTACHMENT_MAX_FILENAME_LENGTH=160
PROCORE_INTAKE_ATTACHMENT_ALLOW_OVERWRITE=false
PROCORE_INTAKE_ATTACHMENT_FIXTURE_DOWNLOADS_ONLY=true

# Local Markdown/JSON onboarding packet artifacts.
PROCORE_INTAKE_PACKET_OUTPUT_ROOT=./packet-output
PROCORE_INTAKE_DEFAULT_REQUESTER_COMPANY_NAME=Your Company
PROCORE_INTAKE_DEFAULT_APP_NAME=Procore Intake Bridge

# Local read-only admin dashboard. The no-token default is for local development only.
PROCORE_INTAKE_ADMIN_DASHBOARD_ENABLED=true
PROCORE_INTAKE_ADMIN_AUTH_MODE=local_optional
PROCORE_INTAKE_ADMIN_TOKEN_HEADER=X-Procore-Intake-Admin-Token
PROCORE_INTAKE_ADMIN_TOKEN_SECRET_REF=
PROCORE_INTAKE_ADMIN_TOKEN_ROTATION_SECRET_REF=
PROCORE_INTAKE_ADMIN_AUTH_FAIL_CLOSED=true
PROCORE_INTAKE_ADMIN_AUTH_PROTECT_DEPLOYMENT_ROUTES=true
PROCORE_INTAKE_ADMIN_AUTH_CACHE_SECONDS=0
# Deprecated compatibility settings; prefer ADMIN_AUTH_MODE and ADMIN_TOKEN_SECRET_REF.
PROCORE_INTAKE_ADMIN_REQUIRE_TOKEN=false
PROCORE_INTAKE_ADMIN_TOKEN_SECRET_NAME=
PROCORE_INTAKE_ADMIN_PAGE_SIZE=25

# Phase B1 manual sandbox-only smoke harness. Keep disabled except for a deliberate,
# approved non-production read probe. Attachment downloads must remain false.
PROCORE_INTAKE_SANDBOX_SMOKE_ENABLED=false
PROCORE_INTAKE_SANDBOX_SMOKE_REQUIRE_CONFIRMATION=true
PROCORE_INTAKE_SANDBOX_SMOKE_CONFIRMATION_PHRASE=I_UNDERSTAND_THIS_IS_READ_ONLY_SANDBOX_ONLY
PROCORE_INTAKE_SANDBOX_SMOKE_ALLOW_PRODUCTION=false
PROCORE_INTAKE_SANDBOX_SMOKE_MAX_RECORDS=3
PROCORE_INTAKE_SANDBOX_SMOKE_OUTPUT_ROOT=./smoke-output
PROCORE_INTAKE_SANDBOX_SMOKE_WRITE_REPORT=true
PROCORE_INTAKE_SANDBOX_SMOKE_ATTACHMENT_DOWNLOADS=false
PROCORE_INTAKE_SANDBOX_SMOKE_CONNECTION_ID=
PROCORE_INTAKE_SANDBOX_SMOKE_PROJECT_ID=
PROCORE_INTAKE_SANDBOX_SMOKE_COMPANY_ID=

# Phase B7 local-only customer deployment planning. Generated output is ignored.
PROCORE_INTAKE_CUSTOMER_DEPLOYMENT_PATTERN_ENABLED=true
PROCORE_INTAKE_CUSTOMER_PROFILE_OUTPUT_ROOT=./customer-output
PROCORE_INTAKE_CUSTOMER_PROFILE_REQUIRE_PLACEHOLDERS=true
PROCORE_INTAKE_CUSTOMER_PROFILE_ALLOW_REAL_IDS=false
PROCORE_INTAKE_CUSTOMER_PROFILE_MAX_PROJECTS=25
PROCORE_INTAKE_CUSTOMER_PROFILE_FAIL_CLOSED=true

# Phase B8 local-only sanitized diagnostics and support bundles.
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_ENABLED=true
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_REDACTION_STRICT=true
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_INCLUDE_DB_COUNTS=true
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_INCLUDE_ROUTE_INVENTORY=true
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_INCLUDE_DEPENDENCY_INVENTORY=true
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_INCLUDE_CONFIG_SUMMARY=true
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_INCLUDE_ENV_KEY_NAMES=false
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_ALLOW_LOCAL_PATHS=false
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_MAX_FINDINGS=100
PROCORE_INTAKE_OPERATOR_DIAGNOSTICS_FAIL_CLOSED=true
PROCORE_INTAKE_SUPPORT_BUNDLE_ENABLED=true
PROCORE_INTAKE_SUPPORT_BUNDLE_OUTPUT_ROOT=./support-output
PROCORE_INTAKE_SUPPORT_BUNDLE_MAX_FILES=10
PROCORE_INTAKE_SUPPORT_BUNDLE_WRITE_JSON=true
PROCORE_INTAKE_SUPPORT_BUNDLE_WRITE_MARKDOWN=true
PROCORE_INTAKE_SUPPORT_BUNDLE_INCLUDE_RAW_LOGS=false
PROCORE_INTAKE_SUPPORT_BUNDLE_INCLUDE_DB_FILE=false
PROCORE_INTAKE_SUPPORT_BUNDLE_INCLUDE_ATTACHMENTS=false
PROCORE_INTAKE_SUPPORT_BUNDLE_INCLUDE_PAYLOADS=false

# Phase B9 local-only pilot go/no-go planning gate.
PROCORE_INTAKE_PILOT_READINESS_ENABLED=true
PROCORE_INTAKE_PILOT_READINESS_OUTPUT_ROOT=./pilot-readiness-output
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_PLACEHOLDERS=true
PROCORE_INTAKE_PILOT_READINESS_ALLOW_REAL_IDS=false
PROCORE_INTAKE_PILOT_READINESS_ALLOW_PRODUCTION=false
PROCORE_INTAKE_PILOT_READINESS_FAIL_CLOSED=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_SANDBOX_SMOKE=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_DMSA_ONBOARDING=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_ADMIN_AUTH=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_MIGRATION_SAFETY=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_STORAGE_REVIEW=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_WEBHOOK_REVIEW=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_SUPPORT_DIAGNOSTICS=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_ROLLBACK_PLAN=true
PROCORE_INTAKE_PILOT_READINESS_REQUIRE_OPERATOR_APPROVALS=true

# Fake placeholder only; never commit a real webhook secret.
PROCORE_INTAKE_SECRET_DEMO_WEBHOOK_SECRET=replace_me_never_commit_real_values

# Fake placeholder only; reference DEMO_ADMIN_TOKEN from the admin setting when testing.
PROCORE_INTAKE_SECRET_DEMO_ADMIN_TOKEN=replace_me_never_commit_real_values

# PLACEHOLDERS ONLY. Replace in an uncommitted .env or runtime secret injection.
# Never commit real client IDs, client secrets, access tokens, or refresh tokens.
PROCORE_INTAKE_SECRET_DEMO_GC_DMSA_CLIENT_ID=replace_me_never_commit_real_values
PROCORE_INTAKE_SECRET_DEMO_GC_DMSA_SECRET=replace_me_never_commit_real_values
