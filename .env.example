# Safe local defaults. Never put credentials or tokens in this file.
APP_DATABASE_URL=sqlite:///./procore_intake_bridge.db
APP_PROCORE_MODE=fixture
APP_FIXTURE_DIR=app/fixtures

# Phase A2 live DMSA boundary. Keep false for normal local development and all tests.
PROCORE_INTAKE_LIVE_MODE_ENABLED=false
PROCORE_INTAKE_SECRET_PROVIDER=env
PROCORE_INTAKE_API_BASE=https://api.procore.com
PROCORE_INTAKE_LOGIN_URL=https://login.procore.com
PROCORE_INTAKE_REQUEST_TIMEOUT_SECONDS=30
PROCORE_INTAKE_ENVIRONMENT=production

# Local run-once polling defaults. No daemon or external queue is used.
PROCORE_INTAKE_DEFAULT_POLLING_INTERVAL_MINUTES=30
PROCORE_INTAKE_SYNC_LOCK_TIMEOUT_MINUTES=30
PROCORE_INTAKE_WORKER_ID=local-dev-worker
PROCORE_INTAKE_MAX_SYNC_LOOKBACK_DAYS=30

# Local webhook receiver and database event queue.
# Header names and HMAC format are configurable placeholders; verify current
# Procore signing documentation before production use.
PROCORE_INTAKE_WEBHOOKS_ENABLED=true
PROCORE_INTAKE_REQUIRE_WEBHOOK_SIGNATURE=false
PROCORE_INTAKE_WEBHOOK_SIGNATURE_HEADER=x-procore-signature
PROCORE_INTAKE_WEBHOOK_EVENT_ID_HEADER=x-procore-event-id
PROCORE_INTAKE_WEBHOOK_SECRET_PROVIDER=env
PROCORE_INTAKE_WEBHOOK_SECRET_NAME=
PROCORE_INTAKE_EVENT_LOCK_TIMEOUT_MINUTES=30
PROCORE_INTAKE_EVENT_MAX_ATTEMPTS=5
PROCORE_INTAKE_EVENT_WORKER_ID=local-dev-event-worker

# Local attachment manifest and fixture-only byte storage.
PROCORE_INTAKE_ATTACHMENT_STORAGE_BACKEND=local
PROCORE_INTAKE_ATTACHMENT_STORAGE_ROOT=./storage/attachments
PROCORE_INTAKE_ATTACHMENT_MAX_FILENAME_LENGTH=160
PROCORE_INTAKE_ATTACHMENT_ALLOW_OVERWRITE=false
PROCORE_INTAKE_ATTACHMENT_FIXTURE_DOWNLOADS_ONLY=true

# Local Markdown/JSON onboarding packet artifacts.
PROCORE_INTAKE_PACKET_OUTPUT_ROOT=./packet-output
PROCORE_INTAKE_DEFAULT_REQUESTER_COMPANY_NAME=Your Company
PROCORE_INTAKE_DEFAULT_APP_NAME=Procore Intake Bridge

# Local read-only admin dashboard. The no-token default is for local development only.
PROCORE_INTAKE_ADMIN_DASHBOARD_ENABLED=true
PROCORE_INTAKE_ADMIN_REQUIRE_TOKEN=false
PROCORE_INTAKE_ADMIN_TOKEN_SECRET_NAME=
PROCORE_INTAKE_ADMIN_PAGE_SIZE=25

# Fake placeholder only; never commit a real webhook secret.
PROCORE_INTAKE_SECRET_DEMO_WEBHOOK_SECRET=replace_me_never_commit_real_values

# Fake placeholder only; reference DEMO_ADMIN_TOKEN from the admin setting when testing.
PROCORE_INTAKE_SECRET_DEMO_ADMIN_TOKEN=replace_me_never_commit_real_values

# PLACEHOLDERS ONLY. Replace in an uncommitted .env or runtime secret injection.
# Never commit real client IDs, client secrets, access tokens, or refresh tokens.
PROCORE_INTAKE_SECRET_DEMO_GC_DMSA_CLIENT_ID=replace_me_never_commit_real_values
PROCORE_INTAKE_SECRET_DEMO_GC_DMSA_SECRET=replace_me_never_commit_real_values
